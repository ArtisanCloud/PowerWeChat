# VS Code 的 main 启动项会读取 .env.local。
# .env.local 已迁移 GoLand main 启动项中保存的变量；请直接编辑它补齐缺失项。
# 本文件只列出变量名，不保存真实凭据。
# 在新环境中可将本文件复制为 .env.local，再填写实际使用的配置。

# 公众号
official_app_id=
official_secret=

# 企业微信
corp_id=
wecom_agent_id=
wecom_secret=
# 实际业务的完整 OAuth 回调 URL，包含 http:// 或 https://。
app_oauth_callback_url=
app_message_token=
app_message_aes_key=
work.env=
wecom_finance_sdk_path=
wecom_finance_sdk_platform=

# 微信支付
app_id=
mch_id=
mch_api_v3_key=
key=
wx_cert_path=
wx_key_path=
serial_no=
certificate_key_path=
wechat_pay_serial=
rsa_public_key_path=
notify_url=

# 小程序
miniprogram_app_id=
miniprogram_secret=

# 通用
array=
